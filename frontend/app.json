{
  "expo": {
    "name": "Collaberry",
    "slug": "collaberry",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "primaryColor": "#0A0A0C",
    "userInterfaceStyle": "dark",
    "scheme": "collaberry",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.collaberry.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0C"
      },
      "package": "com.collaberry.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://envoy.collaberry.boxd.sh",
      "wsBaseUrl": "wss://envoy.collaberry.boxd.sh",
      "router": {},
      "eas": {
        "projectId": "441cf83e-e43e-41f2-b4e1-863c33ff121c"
      }
    },
    "owner": "apmemarian"
  }
}
