# Copy to .env before running `docker compose up`. Sensible dev defaults live in
# the service settings; override here when you need to.

ENVIRONMENT=development

# Datastores (hostnames resolve on the internal compose network)
MONGO_URI=mongodb://mongo:27017
MONGO_DB=collaberry
REDIS_URL=redis://redis:6379/0

# JWT / auth
JWT_ISSUER=collaberry-auth
JWT_AUDIENCE=collaberry-clients
ACCESS_TOKEN_TTL_SECONDS=43200
JWT_PRIVATE_KEY_PATH=/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/keys/jwt_public.pem
JWKS_URI=http://auth-service:8000/api/v1/auth/.well-known/jwks.json

# Collaboration knobs
CARD_LOCK_TTL_SECONDS=30
TYPING_TTL_SECONDS=5
PRESENCE_TTL_SECONDS=45
DEADLINE_WARNING_HOURS=24
